{
  "name": "anchor",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.9",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./public-user": {
      "types": "./utils/publicUser.ts",
      "import": "./utils/publicUser.ts"
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "bench": "bun run benchmarks/run.ts",
    "bench:report": "bun run benchmarks/report.ts",
    "build": "bun build --compile --target bun --outfile ../../testing/server src/index.ts",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "db:push": "bunx --bun drizzle-kit push",
    "email": "email dev --dir src/emails"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.15",
    "@elysiajs/cors": "^1.4.2",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@react-email/components": "^1.0.12",
    "aws4fetch": "^1.0.20",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "elysia": "^1.4.29",
    "elysia-ip": "^1.1.1",
    "elysia-rate-limit": "^4.6.2",
    "fast-average-color-node": "^3.2.0",
    "livekit-server-sdk": "^2.15.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.6.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "bun-types": "latest",
    "drizzle-kit": "^1.0.0-rc.4",
    "nodemailer": "^9.0.4",
    "react-email": "^6.9.1"
  },
  "module": "src/index.js"
}
