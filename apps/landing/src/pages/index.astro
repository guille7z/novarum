---
import Logo from '../../public/favicon.svg'
const githubUrl = 'https://github.com/novarumsocial/novarum';

const principles = [
  {
    title: 'Yours to run',
    copy: 'Host an Anchor and control the data you were meant to own.',
  },
  {
    title: 'Open by default',
    copy: 'Novarum is open source. Read the code, or help improve it!',
  },
  {
    title: 'Federated by design',
    copy: 'Guilds can connect and communicate across different servers seamlessly.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Novarum is a simple, fast, federated chat app for communities."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Novarum - A calm place to talk</title>
  </head>
  <body>
    <header>
      <a class="wordmark" href="/" aria-label="Novarum home">
        <Logo />
        novarum
      </a>

      <nav aria-label="Primary navigation">
        <a href="#about">About</a>
        <a href="/docs/">Docs</a>
        <a href={githubUrl}>GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>Finally.<br /><em>A calm place to talk.</em></h1>

        <div class="hero-footer">
          <p>
            Novarum is the chat app we wanted.<br />
            No BS: just a simple chat app with voice support, that respects your privacy and connects communities through its federation system.
          </p>
          <div class="actions">
            <a class="primary-action" href="/docs/">
              Read the docs
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4"></path>
              </svg>
            </a>
            <a class="secondary-action" href={githubUrl}>View on GitHub</a>
          </div>
        </div>
      </section>

      <section class="about" id="about">
        <p class="section-label">Why Novarum</p>
        <div>
          <h2>No more walled gardens</h2>
          <p>
            Each community lives on an Anchor homeserver. Anchors manage their own data and connect
            to the wider network through federation.
          </p>
        </div>
      </section>

      <section class="principles">
        {
          principles.map((principle, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{principle.title}</h3>
              <p>{principle.copy}</p>
            </article>
          ))
        }
      </section>

      <section class="closing">
        <p class="section-label">Get started</p>
        <div>
          <h2>Novarum is (very) WIP.</h2>
          <p>Though you can explore the documentation, deploy an Anchor, or contribute on Github.</p>
          <div class="closing-links">
            <a href="/guides/deployment/">Deploy an Anchor <span aria-hidden="true">↗</span></a>
            <a href={githubUrl}>Explore the project <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <span>© {new Date().getFullYear()} Novarum, under AGPL</span>
      <span>A calm place to talk</span>
    </footer>
  </body>
</html>

<style>
  :root {
    --background: oklch(0.145 0.008 326);
    --foreground: oklch(0.985 0 0);
    --muted: oklch(0.711 0.019 323.02);
    --line: oklch(1 0 0 / 10%);
    --accent: oklch(0.45 0.085 224.283);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background: var(--background);
  }

  body {
    width: min(100%, 1520px);
    min-height: 100vh;
    margin: 0 auto;
    background: var(--background);
    color: var(--foreground);
    font-family: 'Avenir Next', Avenir, 'Helvetica Neue', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  header {
    display: flex;
    min-height: 84px;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(1.25rem, 4vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.035em;
  }

  .wordmark svg {
    width: 1.35rem;
    color: var(--accent);
    fill: var(--accent);
  }

  nav {
    display: flex;
    gap: clamp(1.4rem, 3vw, 2.8rem);
    font-size: 0.76rem;
    font-weight: 600;
  }

  nav a,
  .secondary-action,
  .closing-links a {
    text-underline-offset: 0.3rem;
  }

  nav a:hover,
  .secondary-action:hover,
  .closing-links a:hover {
    text-decoration: underline;
  }

  .hero {
    min-height: min(780px, calc(100vh - 84px));
    padding: clamp(4rem, 9vw, 8.5rem) clamp(1.25rem, 4vw, 4rem) 3rem;
    border-bottom: 1px solid var(--line);
  }

  .kicker,
  .section-label {
    margin: 0;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-weight: 400;
    letter-spacing: -0.055em;
  }

  h1 {
    max-width: 1260px;
    margin: 2.4rem 0 5rem;
    font-size: clamp(4rem, 10.2vw, 10rem);
    line-height: 0.84;
  }

  h1 em {
    color: var(--accent);
    font-weight: 400;
  }

  .hero-footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: end;
    margin-top: auto;
  }

  .hero-footer > p {
    max-width: 34rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.4vw, 1.22rem);
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 1.5rem;
    align-items: center;
  }

  .primary-action {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: 1.2rem;
    padding: 0 1rem;
    background: var(--foreground);
    color: var(--background);
    font-size: 0.76rem;
    font-weight: 650;
  }

  .primary-action svg {
    width: 1rem;
    stroke-width: 1.3;
    transition: transform 160ms ease;
  }

  .primary-action:hover svg {
    transform: translateX(0.2rem);
  }

  .secondary-action {
    font-size: 0.76rem;
    font-weight: 650;
  }

  .about,
  .closing {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(3rem, 8vw, 9rem);
    padding: clamp(5rem, 10vw, 9rem) clamp(1.25rem, 4vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .about > div,
  .closing > div {
    max-width: 60rem;
  }

  h2 {
    margin: 0;
    font-size: clamp(3rem, 6.5vw, 6.5rem);
    line-height: 0.98;
  }

  .about > div > p,
  .closing > div > p {
    max-width: 40rem;
    margin: 2.5rem 0 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--line);
  }

  .principles article {
    min-height: 300px;
    padding: 2rem clamp(1.25rem, 3vw, 3rem);
    border-right: 1px solid var(--line);
  }

  .principles article:last-child {
    border-right: 0;
  }

  .principles span {
    color: var(--accent);
    font-family: 'Iowan Old Style', Georgia, serif;
    font-size: 0.76rem;
  }

  .principles h3 {
    margin: 5rem 0 0.75rem;
    font-size: 1.12rem;
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  .principles p {
    max-width: 22rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .closing-links {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 3rem;
  }

  .closing-links a {
    font-size: 0.8rem;
    font-weight: 650;
  }

  .closing-links span {
    margin-left: 0.35rem;
    color: var(--accent);
  }

  footer {
    display: flex;
    min-height: 100px;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(1.25rem, 4vw, 4rem);
    color: var(--muted);
    font-size: 0.7rem;
  }

  @media (max-width: 760px) {
    header {
      min-height: 72px;
    }

    nav {
      gap: 1.1rem;
    }

    nav a:first-child {
      display: none;
    }

    .hero {
      min-height: 680px;
      padding-top: 5rem;
    }

    h1 {
      margin-block: 2rem 4rem;
      font-size: clamp(3.8rem, 19vw, 6.5rem);
      line-height: 0.88;
    }

    .hero-footer,
    .about,
    .closing {
      grid-template-columns: 1fr;
    }

    .actions {
      justify-content: flex-start;
    }

    .principles {
      grid-template-columns: 1fr;
    }

    .principles article {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .principles article:last-child {
      border-bottom: 0;
    }

    .principles h3 {
      margin-top: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    * {
      transition: none !important;
    }
  }
</style>
